<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="15sp" android:textStyle="bold" android:textColor="@color/w_accent" android:maxLines="1" android:ellipsize="end" android:text="챙김이" />
    <TextView android:id="@+id/w_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/w_ink" android:lineSpacingExtra="2dp" android:ellipsize="end" android:text="" />
    <TextView android:id="@+id/w_foot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="11sp" android:textColor="@color/w_sub" android:maxLines="1" android:ellipsize="end" android:text="챙김이 · 눌러서 열기" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/w_done" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:gravity="center"
            android:background="@drawable/widget_btn" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_accent" android:maxLines="1" android:ellipsize="end" android:visibility="gone" android:text="" />
        <TextView android:id="@+id/w_shop" android:layout_width="wrap_content" android:layout_height="32dp" android:layout_marginStart="6dp" android:gravity="center" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:background="@drawable/widget_btn" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/w_accent" android:visibility="gone" android:text="🛒 담기" />
    </LinearLayout>
</LinearLayout>
